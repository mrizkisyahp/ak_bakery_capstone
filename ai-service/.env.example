# application
APP_NAME = Adiskirani Bakery AI Service
APP_ENV=development
APP_DEBUG=true

# API security
AI_SERVICE_API_KEY=

# gonka broker
GONKA_API_KEY=
GONKA_BASE_URL=https://proxy.gonkabroker.com/v1

# embedding model
EMBEDDING_PROVIDER=gonka
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING-DIMENSION=1024

# LLM
LLM_PROVIDER=gonka
LLM_MODEL=

# Qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=adiskirani_faq